---
import Layout from "../layouts/Layout.astro";


const cf = Astro.locals.runtime?.cf || null;
---

<Layout title="Advanced Drug Wars | arca.de">
	<main>
		<game-ui geo-data={JSON.stringify(cf)}></game-ui>
	</main>
</Layout>

<script>
	import "../components/GameUI";
</script>

<style>
	main {
		margin: auto;
		width: 100%;
		max-width: calc(100% - 2rem);
		color: white;
		font-size: 20px;
		line-height: 1.6;
	}
</style>
