---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Level Not Found | arca.de">
    <main class="h-screen flex items-center justify-center bg-slate-950 text-runner">
        <div class="text-center space-y-4">
            <h1 class="text-6xl font-black tracking-tighter animate-pulse">404</h1>
            <p class="text-sm font-mono tracking-widest uppercase opacity-50">Segment Missing. Reality Recalibrating.</p>
            <a href="/" class="block mt-8 text-xs font-bold underline hover:text-white transition-colors">[ REBOOT TO CORE ]</a>
        </div>
    </main>
</Layout>
