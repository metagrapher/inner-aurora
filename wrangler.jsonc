{
    "name": "inner-aurora",
    "main": "./src/entry.ts",
    "compatibility_date": "2026-01-07",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "minify": true,
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "GUN_RELAY",
                "class_name": "GunRelay"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_classes": [
                "GunRelay"
            ]
        }
    ],
    "observability": {
        "enabled": true
    },
    "routes": [
        {
            "pattern": "drugwars.arca.de.com",
            "custom_domain": true
        }
    ]
}